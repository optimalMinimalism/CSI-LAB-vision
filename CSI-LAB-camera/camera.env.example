CSI_VIDEO_TOKEN=replace-with-the-same-long-token-used-by-the-backend
CSI_VIDEO_SERVER=http://192.168.1.100:8766
CSI_VIDEO_DEVICE=0
CSI_VIDEO_WIDTH=640
CSI_VIDEO_HEIGHT=480
CSI_VIDEO_FPS=10
CSI_VIDEO_CAPTURE_BACKEND=opencv
# Optional: explicitly name a Benewake UART; leave unset to disable serial access.
# CSI_BENEWAKE_DEVICE=/dev/serial0
# CSI_BENEWAKE_MODEL=tf02-pro
# CSI_BENEWAKE_BAUD=115200
# CSI_BENEWAKE_WORKER=/usr/local/bin/benewakeCapture
