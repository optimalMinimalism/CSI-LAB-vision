CSI_VIDEO_TOKEN=replace-with-a-long-random-token
CSI_VIDEO_DATA=./data
CSI_VIDEO_HOST=127.0.0.1
CSI_VIDEO_PORT=8765
CSI_VIDEO_SERVER=http://127.0.0.1:8765
CSI_VIDEO_DEVICE=0
CSI_VIDEO_WIDTH=640
CSI_VIDEO_HEIGHT=480
CSI_VIDEO_FPS=10
CSI_VIDEO_QUEUE=8
# Bound on read-completion versus exposure, measured on your camera; empty = unknown.
CSI_VIDEO_CAPTURE_UNCERTAINTY_MS=
CSI_VIDEO_MODEL=./models/yolo11n-pose.pt
CSI_VIDEO_AUTO_CONFIDENCE=0.9
CSI_VIDEO_MAX_SYNC_MS=20
CSI_VIDEO_MIN_CONSISTENT_FRAMES=3
# Enable only after measuring posture error on this camera/site.
CSI_VIDEO_CALIBRATED_POSTURES=false
CSI_VIDEO_STATIONARY_CAMERA=false
# Optional compiled cameraCapture executable (Pi). Empty = Python/OpenCV capture.
CSI_VIDEO_NATIVE_CAPTURE=
CSI_VIDEO_INFERENCE_THREADS=2
CSI_VIDEO_DETECTOR_CONFIDENCE=0.25

# Live preview analysis: one shared pose extraction, three separate stages.
CSI_VIDEO_LIVE_INFERENCE=true
CSI_VIDEO_LIVE_IMAGE_SIZE=416
# Camera is monochrome; YOLO receives three identical grayscale channels.
CSI_VIDEO_MONOCHROME=true
# [experimental] Separate low-priority distance screen; local detection + pose weights.
CSI_VIDEO_DISTANCE_MODEL=./models/yolo11n.pt
CSI_VIDEO_DISTANCE_POSE_MODEL=./models/yolo11n-pose.pt
CSI_VIDEO_DISTANCE_CONFIDENCE=0.5
